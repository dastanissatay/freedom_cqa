# ---- Данные организаторов ----
# URL API без параметров; group_id подставляется из интерфейса (?group_id=DEV)
DATASET_API_URL=https://example.com/api/dataset
DEFAULT_GROUP_ID=DEV

# ---- LLM ----
# anthropic | openai_compat | mock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# low | medium | high (только для anthropic)
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_MAX_RETRIES=2

ANTHROPIC_API_KEY=

# Для openai_compat (vLLM / Ollama / OpenRouter на своих GPU)
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=EMPTY

# Цена модели, $ за 1M токенов (для расчёта стоимости оценки; пусто = из встроенной таблицы)
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# ---- Выгрузка и данные ----
TEAM_NAME=Qazyna
# маскировать ИИН, карты, IBAN, телефоны, e-mail перед отправкой транскрипта в LLM
PII_MASKING=true

# ---- Прочее ----
DB_PATH=data/cqa.db
BATCH_CONCURRENCY=4
# Разрешённые источники для CORS (через запятую), * = все
CORS_ORIGINS=*
